# Bot と共有する Redis（compose のサービス名）
REDIS_URL=redis://redis:6379
# Irodori-TTS サーバー
IRODORI_TTS_BASE_URL=http://irodori-tts:8765
# Bot と同じ値を設定する（未設定なら Irodori-TTS の先頭話者を使う）
DEFAULT_SPEAKER_ID=

# --- Discord OAuth（本番必須 / 開発バイパス時は省略可） ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/callback
# 本番（HTTPS）では true
COOKIE_SECURE=false

# --- 開発用ログインバイパス ---
# true にすると Discord ログインなしでログイン済みとして扱う。
# NODE_ENV=production では強制的に無効化されるため本番には効かない。
DEV_AUTH_BYPASS=false
DEV_AUTH_USER_ID=000000000000000000
DEV_AUTH_USERNAME=dev-user
