{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "AUTO_COMMIT_NESTED": "1"
  },
  "permissions": {
    "deny": [
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git config --global:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(pnpx:*)",
      "Bash(rm -rf /:*)",
      "Bash(yarn:*)",
      "Edit(**/*.pem)",
      "Edit(**/.dev.vars)",
      "Edit(**/.dev.vars.*)",
      "Edit(**/.dev.vars.development)",
      "Edit(**/.dev.vars.local)",
      "Edit(**/.dev.vars.production)",
      "Edit(**/.dev.vars.staging)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(**/.secrets)",
      "Edit(**/.secrets/**)",
      "Edit(**/private.key)",
      "Read(**/*.pem)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(**/.dev.vars.development)",
      "Read(**/.dev.vars.local)",
      "Read(**/.dev.vars.production)",
      "Read(**/.dev.vars.staging)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.secrets)",
      "Read(**/.secrets/**)",
      "Read(**/private.key)"
    ]
  }
}
